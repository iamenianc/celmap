<Application x:Class="CelMap.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CelMap.App"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Green" SecondaryColor="Lime"
                                             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" />
                <!-- BundledTheme supplies colors/brushes but not the named control styles
                     (MaterialDesignRaisedButton, MaterialDesignOverlineTextBlock,
                     MaterialDesignComboBox, …) this app references. MaterialDesign3.Defaults
                     transitively merges every per-control style dictionary. -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- Palette -->
        <Color x:Key="AccentColor">#3d7a5a</Color>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="PanelBg" Color="#ffffff" />
        <SolidColorBrush x:Key="WindowBg" Color="#f2f4f3" />
        <SolidColorBrush x:Key="TargetPanelBg" Color="#f8faf9" />
        <!-- Header-column zebra band: darker than the #f8faf9 header so the banding is
             actually visible against it. -->
        <SolidColorBrush x:Key="HeaderZebraBg" Color="#e9efeb" />
        <SolidColorBrush x:Key="Hairline" Color="#dde3df" />
        <SolidColorBrush x:Key="MutedText" Color="#6e8078" />
        <SolidColorBrush x:Key="InkText" Color="#1a2420" />
        <SolidColorBrush x:Key="WarnBg" Color="#faf0d8" />            <!-- borderline fuzzy (=90%) -->
        <SolidColorBrush x:Key="WarnText" Color="#8a6010" />
        <SolidColorBrush x:Key="StrongFuzzyBg" Color="#fbf6e6" />     <!-- high-confidence fuzzy (>90%) -->
        <SolidColorBrush x:Key="StrongFuzzyText" Color="#a8862b" />
        <SolidColorBrush x:Key="WeakFuzzyBg" Color="#f7e2cf" />       <!-- weak fuzzy (<90%) -->
        <SolidColorBrush x:Key="WeakFuzzyText" Color="#a8501a" />
        <SolidColorBrush x:Key="GridLine" Color="#c8d0cb" />
        <SolidColorBrush x:Key="HeaderCellBg" Color="#f8faf9" />
        <SolidColorBrush x:Key="AutoTint" Color="#daeade" />     <!-- auto-mapped slot -->
        <SolidColorBrush x:Key="ManualTint" Color="#eaf2ec" />   <!-- user-mapped slot -->
        <SolidColorBrush x:Key="DropZoneBg" Color="#f0f3f1" />

        <!-- Typography defaults -->
        <Style TargetType="{x:Type Control}">
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock"
               BasedOn="{StaticResource MaterialDesignOverlineTextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- Primary button — MD raised gives ripple + state layers + correct disabled
             treatment for free; the green comes from the bundled Green/Lime theme. -->
        <Style x:Key="PrimaryButton" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="md:ButtonAssist.CornerRadius" Value="6" />
            <Setter Property="Height" Value="40" />
        </Style>

        <!-- Secondary (outline) button — MD outlined; same external API as before. -->
        <Style x:Key="GhostButton" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="md:ButtonAssist.CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
        </Style>

        <!-- Filter toggle — a pill that reads as on/off at a glance. Replaces the easily-missed
             checkbox for the source/target visibility filters: green fill + check when on,
             outlined + muted when off. -->
        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" Background="White"
                                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                                CornerRadius="11" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="check" Text="✓ " FontSize="11"
                                           Foreground="White" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter TargetName="check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tertiary text-link button — for rare, demoted actions (e.g. "use a custom file").
             MD flat/text button: no border or fill, ripple on the accent. -->
        <Style x:Key="LinkButton" TargetType="Button"
               BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="4,2" />
        </Style>

        <Style TargetType="Label">
            <Setter Property="Padding" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{StaticResource MutedText}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>

        <!-- MD floating-label inputs: keyed so only the form fields opt in (the dense
             grid pickers keep the plain default styles above). HintAssist.Hint supplies
             the floating label; HintAssist.HelperText replaces hand-rolled hints. -->
        <Style x:Key="Field" TargetType="TextBox"
               BasedOn="{StaticResource MaterialDesignOutlinedTextBox}" />
        <Style x:Key="FieldCombo" TargetType="ComboBox"
               BasedOn="{StaticResource MaterialDesignOutlinedComboBox}" />
        <Style x:Key="FieldDate" TargetType="DatePicker"
               BasedOn="{StaticResource MaterialDesignOutlinedDatePicker}" />

        <!-- Soft accent tint for the "needs input" state of required fields. -->
        <SolidColorBrush x:Key="RequiredTint" Color="#eaf4ee" />

        <!-- Required text field that needs attention: while empty it gets a thicker accent
             outline, accent floating label, and a soft accent tint so it reads as a
             call-to-action ("fill me in"). Once the user types a value the highlight
             reverts to the neutral Field look. -->
        <Style x:Key="RequiredField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{StaticResource RequiredTint}" />
                    <Setter Property="md:HintAssist.Foreground" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DatePicker counterpart of RequiredField: highlights the same way while no date
             is selected, clearing once the user picks one. -->
        <Style x:Key="RequiredFieldDate" TargetType="DatePicker" BasedOn="{StaticResource FieldDate}">
            <Style.Triggers>
                <Trigger Property="SelectedDate" Value="{x:Null}">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter Property="BorderThickness" Value="2" />
                    <Setter Property="Background" Value="{StaticResource RequiredTint}" />
                    <Setter Property="md:HintAssist.Foreground" Value="{StaticResource Accent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Reusable count-badge chip — replaces the repeated Border+StackPanel badges
             in MappingView. Per-chip Background/Foreground stay local since they're semantic. -->
        <Style x:Key="StatChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,5,0" />
        </Style>

        <!-- Excel-like grid cells — readable font, single line, truncated with a tooltip.
             Compact: tighter padding buys ~4 extra visible rows per grid. -->
        <Style x:Key="GridDataCell" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource InkText}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Header cell at the top of a grid column — tall enough for two wrapped lines so
             long insurance column names stay readable instead of truncating. -->
        <Style x:Key="GridHeaderCell" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource HeaderCellBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource GridLine}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Height" Value="40" />
        </Style>

        <!-- File drop-zone on the setup screen — compact -->
        <Style x:Key="DropZone" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource DropZoneBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinHeight" Value="64" />
        </Style>

        <local:BoolToVisibilityConverter x:Key="BoolToVis" />
        <local:StringMatchToVisibilityConverter x:Key="StateToVis" />
        <local:CountToVisibilityConverter x:Key="CountToVis" />
        <local:ExcludeCurrentItemConverter x:Key="ExcludeCurrentItem" />
        <local:AvailableSourcesForRowConverter x:Key="AvailableSourcesForRow" />
        <local:StringToUpperConverter x:Key="StringToUpper" />
        <local:LinkIndexToBrushConverter x:Key="LinkIndexToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
