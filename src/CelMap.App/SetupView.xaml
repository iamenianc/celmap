<UserControl x:Class="CelMap.App.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CelMap.App"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SetupViewModel}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Set up your mapping" FontSize="17" FontWeight="SemiBold"
                           Foreground="{StaticResource InkText}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Pick the file you're copying FROM and the template you're copying INTO, then confirm each sheet and header row."
                           Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Aa" FontSize="11" Foreground="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox Width="110" FontSize="11"
                          Style="{StaticResource MaterialDesignComboBox}"
                          ItemsSource="{Binding DataContext.DensityOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding DataContext.UiDensity, RelativeSource={RelativeSource AncestorType=Window}}"
                          ToolTip="Display size — Large for easier reading, Compact for more on screen" />
            </StackPanel>
        </Grid>

        <!-- Two panels side by side: Source and Target. Fixed height keeps the
             window compact regardless of how many columns a sheet has. -->
        <Grid Grid.Row="1" Height="330">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SOURCE -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="SOURCE  ·  copy data FROM" Style="{StaticResource SectionHeader}" />
                    <Border x:Name="SourceDropZone" DockPanel.Dock="Top" Style="{StaticResource DropZone}"
                            AllowDrop="True" Drop="SourceDropZone_Drop"
                            DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                            MouseLeftButtonUp="SourceDropZone_Click" Cursor="Hand">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SourceFileName, FallbackValue='Drop an .xlsx / .xlsm here'}"
                                       FontSize="14" FontWeight="SemiBold" TextAlignment="Center"
                                       Foreground="{StaticResource InkText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="or click to browse" FontSize="12" TextAlignment="Center"
                                       Foreground="{StaticResource MutedText}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ComboBox ItemsSource="{Binding SourceSheets}"
                                      SelectedItem="{Binding SelectedSourceSheet}"
                                      Style="{StaticResource FieldCombo}"
                                      md:HintAssist.Hint="Sheet"
                                      md:HintAssist.HelperText="{Binding SourceRowCountDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBox Text="{Binding SourceHeaderRow, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}"
                                     md:HintAssist.Hint="Header row"
                                     Width="76" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Top" Text="Columns in sheet:" FontSize="11"
                               Foreground="{StaticResource MutedText}" Margin="0,8,0,3" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding SourceColumnsText}"
                                   FontSize="12" Foreground="{StaticResource InkText}"
                                   TextWrapping="Wrap" LineHeight="18" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- TARGET -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="TARGET  ·  copy data INTO  (a copy is written, original untouched)"
                               Style="{StaticResource SectionHeader}" TextTrimming="CharacterEllipsis" />

                    <Border DockPanel.Dock="Top" Style="{StaticResource DropZone}" Cursor="Arrow">
                        <StackPanel VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding TargetChoices}"
                                      SelectedItem="{Binding SelectedTargetChoice}"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource FieldCombo}"
                                      md:HintAssist.Hint="Choose a target template"
                                      ToolTip="Select a target template from the approved templates folder" />
                            <TextBlock Text="No templates found — change the folder or use a custom file." FontSize="11"
                                       Foreground="{StaticResource WarnText}" Margin="0,4,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TargetChoices.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ComboBox ItemsSource="{Binding TargetSheets}"
                                      SelectedItem="{Binding SelectedTargetSheet}"
                                      Style="{StaticResource FieldCombo}"
                                      md:HintAssist.Hint="Sheet"
                                      md:HintAssist.HelperText="{Binding TargetRowCountDisplay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBox Text="{Binding TargetHeaderRow, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource Field}"
                                     md:HintAssist.Hint="Header row"
                                     Width="76" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>

                    <!-- Review details fill the space beneath the target picker.
                         Group ID and Review Start Date are the final inputs before mapping. -->
                    <StackPanel DockPanel.Dock="Top" Margin="0,14,0,0">
                        <TextBlock Text="REVIEW DETAILS" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBox x:Name="GroupIdInput"
                                         Style="{StaticResource RequiredField}"
                                         md:HintAssist.Hint="Group ID (required)"
                                         md:HintAssist.HelperText="Must be an integer"
                                         Text="{Binding DataContext.Parameters.GroupIdText, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <DatePicker Style="{StaticResource RequiredFieldDate}"
                                            md:HintAssist.Hint="Review Start Date (required)"
                                            SelectedDate="{Binding DataContext.Parameters.ReviewStart, RelativeSource={RelativeSource AncestorType=Window}}"
                                            SelectedDateFormat="Short" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Template-folder controls: pinned to the bottom of the panel, with a
                         hairline above so they read as a distinct footer rather than colliding
                         with the Group ID helper text.
                         The folder name is a link that opens Explorer; "Change…" repoints it. -->
                    <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Hairline}"
                            BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Templates:" FontSize="11"
                                   Foreground="{StaticResource MutedText}" VerticalAlignment="Center"
                                   Margin="0,0,4,0" />
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Left"
                                Content="{Binding TemplateFolderDisplay}"
                                Command="{Binding OpenTemplateFolderCommand}"
                                ToolTip="{Binding TargetTemplateDirectory}" />
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}"
                                Content="Change folder" Margin="8,0,0,0"
                                Command="{Binding ChangeTemplateFolderCommand}"
                                ToolTip="Pick a different template folder" />
                        <Button Grid.Column="3" Style="{StaticResource LinkButton}"
                                Content="Use custom file…" Margin="8,0,0,0"
                                Command="{Binding BrowseCustomTargetCommand}"
                                ToolTip="Rarely needed — point at a target file outside the templates folder" />
                    </Grid>
                    </Border>

                    <!-- Filler so the folder controls dock to the bottom -->
                    <Grid />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer: Map button (left, with its enablement hint right beside it) and the
             output folder (right). Everything shares one bottom baseline. -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Map →" Style="{StaticResource PrimaryButton}"
                        MinWidth="150" VerticalAlignment="Center" HorizontalAlignment="Left"
                        Command="{Binding DataContext.MatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        ToolTip="Auto-map the confident columns and open the mapping screen" />

                <TextBlock Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center"
                           Foreground="{StaticResource WarnText}" FontSize="12" TextWrapping="Wrap"
                           Text="Enter a Group ID and Review Start Date to enable mapping."
                           Visibility="{Binding DataContext.IsParametersValid, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />

                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBox Width="240" HorizontalAlignment="Left"
                             Style="{StaticResource Field}"
                             md:HintAssist.Hint="Output folder"
                             Text="{Binding DataContext.OutputDirectory, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Source-load progress: a determinate bar shown while the workbook DOM loads. -->
        <Border Grid.Row="3" Margin="0,12,0,0" Padding="14,12"
                Background="#f8faf9" CornerRadius="6"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1"
                Visibility="{Binding IsLoadingSource, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LoadProgressText}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource InkText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center"
                               FontSize="13" Foreground="{StaticResource MutedText}"
                               Text="{Binding LoadProgress, StringFormat='{}{0:0}%'}" />
                </Grid>
                <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                             Height="22" Minimum="0" Maximum="100"
                             Value="{Binding LoadProgress}" />
                <TextBlock Text="Estimated — large files take a few seconds to open."
                           FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
